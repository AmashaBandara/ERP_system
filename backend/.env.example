# Backend environment variables (copy to backend/.env)
NODE_ENV=development
PORT=4000

# CORS allow-list (comma separated, no spaces)
CORS_ORIGINS=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=waikkal
DB_PASSWORD=waikkal
DB_NAME=waikkal_erp

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Bootstrap super-admin password (used only by the seed when no super admin exists)
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# Optional cloud backup when scripts/backup.ps1 -Cloud is used
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=